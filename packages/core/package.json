{
  "name": "@cranea/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cifra": "./src/cifra/index.ts",
    "./levels/cifra.json": "./levels/cifra.json",
    "./puentes": "./src/puentes/index.ts",
    "./levels/puentes.json": "./levels/puentes.json",
    "./nonograma": "./src/nonograma/index.ts",
    "./levels/nonograma.json": "./levels/nonograma.json",
    "./palabra": "./src/palabra/index.ts",
    "./palabra/words": "./src/palabra/words.ts",
    "./levels/palabra.json": "./levels/palabra.json",
    "./torres": "./src/torres/index.ts",
    "./levels/torres.json": "./levels/torres.json",
    "./achievements": "./src/achievements/index.ts",
    "./protectors": "./src/protectors/index.ts",
    "./motion": "./src/motion.ts",
    "./i18n": "./src/i18n/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "levels": "tsx scripts/build-levels.ts",
    "audit:levels": "tsx scripts/audit-levels.ts",
    "levels:puentes": "tsx scripts/build-puentes.ts",
    "levels:nonograma": "tsx scripts/build-nonograma.ts",
    "levels:palabra": "tsx scripts/build-palabra-levels.ts",
    "levels:torres": "tsx scripts/build-torres.ts"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "@types/node": "25.9.9"
  }
}
