# Copiá este archivo a .env.local (no se sube al repo). Son valores PÚBLICOS: van dentro de la app.
# Mismo deployment de Convex que la web (NEXT_PUBLIC_CONVEX_URL en apps/web/.env.local).
EXPO_PUBLIC_CONVEX_URL=https://<tu-deployment>.convex.cloud
# Misma instancia de Clerk que la web (pk_test_… en desarrollo, pk_live_… en producción).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
