# Copiá este archivo a .env.local (no se sube al repo). Son valores PÚBLICOS: van dentro de la app.
# Mismo deployment de Convex que la web (NEXT_PUBLIC_CONVEX_URL en apps/web/.env.local).
EXPO_PUBLIC_CONVEX_URL=https://<tu-deployment>.convex.cloud
# Misma instancia de Clerk que la web (pk_test_… en desarrollo, pk_live_… en producción).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Craneá Plus (RevenueCat → Project settings → API keys, las "public app-specific"). Sin ellas no se puede comprar.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob. Vacíos = anuncios de PRUEBA de Google (lo correcto en desarrollo). Los ids de app se leen al
# compilar (config plugin): si los cambiás, hace falta un build nuevo.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=
